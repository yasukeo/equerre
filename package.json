{
  "name": "equerre",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "vitest run --config vitest.rls.config.mts",
    "test:e2e": "playwright test",
    "db:types": "tsx --env-file=.env.local scripts/types.mts",
    "db:push": "supabase db push",
    "db:seed": "tsx --env-file=.env.local scripts/seed.mts",
    "storage:sweep": "tsx --env-file=.env.local scripts/sweep-lesson-storage.mts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@date-fns/tz": "1.5.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-list-item": "3.31.3",
    "@tiptap/extension-mathematics": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/static-renderer": "3.31.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.0",
    "date-fns": "4.4.0",
    "katex": "0.18.7",
    "lucide-react": "1.45.0",
    "next": "16.3.5",
    "next-intl": "4.14.5",
    "pdf-lib": "1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.28.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@next/playwright": "16.3.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "postgres": "3.4.9",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.21.0",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "tw-animate-css": "1.4.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.0"
  }
}
