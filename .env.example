# Public site URL (no trailing slash). Used for auth redirects, OG images and ICS links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Settings > API Keys > "Publishable and secret API keys"
NEXT_PUBLIC_SUPABASE_URL=https://sharzrtzesqofwpogvii.supabase.co
# Safe in the browser: every table is protected by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never prefix with NEXT_PUBLIC_. Every use is listed in DECISIONS.md.
SUPABASE_SECRET_KEY=sb_secret_...

# Direct Postgres connection string, used only by `pnpm db:seed` on a developer machine.
# Settings > Database > Connection string (Session pooler).
SUPABASE_DB_URL=postgresql://postgres.sharzrtzesqofwpogvii:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Resend — leave empty in development: emails are logged to the console instead.
RESEND_API_KEY=
EMAIL_FROM="Équerre <bonjour@example.com>"

# Shared secret that Supabase Cron sends to /api/cron/rappels (see supabase/cron.sql). 32+ characters.
CRON_SECRET=

# Password given to every seed account by `pnpm db:seed`. Letters, digits and dashes only.
SEED_PASSWORD=
